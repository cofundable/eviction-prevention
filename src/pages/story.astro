---
import BaseLayout from "../layouts/BaseLayout.astro";
import Scatterplot from "../components/Scatterplot.svelte";
import LandlordCharts from "../components/LandlordCharts.svelte";

let csaFeatures: Record<string, unknown>[] = [];
let landlordTop20: {
  plaintiff: string;
  evictions: number;
  not_evicted: number;
  total: number;
}[] = [];
let concentrationData: { tier: string; pct: number; color: string }[] = [];

try {
  const fs = await import("fs");
  const path = await import("path");

  // CSA features — generated by scripts/generate-downloads.ts from local D1
  const csaPath = path.resolve(
    process.cwd(),
    "public/downloads/csa_features.csv"
  );
  if (fs.existsSync(csaPath)) {
    const lines = fs.readFileSync(csaPath, "utf-8").trim().split("\n");
    const headers = lines[0].split(",");
    csaFeatures = lines.slice(1).map((line) => {
      const vals = line.split(",");
      return Object.fromEntries(
        headers.map((h, i) => [
          h.trim(),
          isNaN(Number(vals[i])) || vals[i] === "" ? vals[i] : Number(vals[i]),
        ])
      );
    });
  }

  // Landlord data — also from generate-downloads.ts
  const masterPath = path.resolve(
    process.cwd(),
    "public/downloads/landlord_master.csv"
  );
  if (fs.existsSync(masterPath)) {
    const lines = fs
      .readFileSync(masterPath, "utf-8")
      .trim()
      .split("\n")
      .slice(1);
    const parsed = lines
      .map((line) => {
        const parts =
          line.match(/("(?:[^"]|"")*"|[^,]+|(?<=,)(?=,)|(?<=,)$|^(?=,))/g) ??
          line.split(",");
        const clean = (s: string) =>
          s.replace(/^"|"$/g, "").replace(/""/g, '"').trim();
        return {
          plaintiff: clean(parts[0] ?? ""),
          sdat_owner: clean(parts[1] ?? ""),
          total_warrants: Number(parts[2] ?? 0),
          total_evictions: Number(parts[3] ?? 0),
        };
      })
      .filter((r) => r.total_warrants > 0);

    const entityMap = new Map<
      string,
      { label: string; total_warrants: number; total_evictions: number }
    >();
    for (const r of parsed) {
      const key = r.sdat_owner || r.plaintiff;
      const label = r.sdat_owner
        ? r.sdat_owner.replace(/\s+/g, " ").trim()
        : r.plaintiff;
      const existing = entityMap.get(key);
      if (existing) {
        existing.total_warrants += r.total_warrants;
        existing.total_evictions += r.total_evictions;
      } else {
        entityMap.set(key, {
          label,
          total_warrants: r.total_warrants,
          total_evictions: r.total_evictions,
        });
      }
    }

    const all = [...entityMap.values()].sort(
      (a, b) => b.total_warrants - a.total_warrants
    );

    landlordTop20 = all.slice(0, 20).map((r) => ({
      plaintiff: r.label,
      evictions: r.total_evictions,
      not_evicted: r.total_warrants - r.total_evictions,
      total: r.total_warrants,
    }));

    const grandTotal = all.reduce((s, r) => s + r.total_warrants, 0);
    const pct = (n: number) => Math.round((n / grandTotal) * 100);
    const top3 = all.slice(0, 3).reduce((s, r) => s + r.total_warrants, 0);
    const next17 = all.slice(3, 20).reduce((s, r) => s + r.total_warrants, 0);
    const next80 = all
      .slice(20, 100)
      .reduce((s, r) => s + r.total_warrants, 0);
    const rest = all.slice(100).reduce((s, r) => s + r.total_warrants, 0);
    concentrationData = [
      { tier: "Top 3", pct: pct(top3), color: "#b88500" },
      { tier: "4th–20th", pct: pct(next17), color: "#d4a843" },
      { tier: "21st–100th", pct: pct(next80), color: "#e6ce8e" },
      {
        tier: `Remaining ${all.slice(100).length}`,
        pct: pct(rest),
        color: "#f5edda",
      },
    ];
  }
} catch {
  // Silently skip if files not available during build
}
---

<BaseLayout
  title="Findings"
  description="A data-driven analysis of who gets evicted in Baltimore and who's doing the evicting."
>
  <article class="story">
    <!-- 1. Hook -->
    <section class="story__section story__section--dark">
      <div class="container container--prose">
        <h1>Social Determinants of Eviction</h1>
        <div class="display-stat">3,000+</div>
        <p class="lead">
          In a single month — December 2024 — Baltimore landlords filed more
          than 3,000 eviction warrants. That's roughly <strong
            >one in every 83 households</strong
          >. But most of those warrants never resulted in an actual eviction.
        </p>
      </div>
    </section>

    <!-- 2. Framing -->
    <section class="story__section">
      <div class="container container--prose">
        <h2>The social determinants of health — applied to housing</h2>
        <p>
          Public health has long recognized that health outcomes are shaped by
          social and structural factors — income, race, neighborhood — more than
          individual behavior. We applied the same lens to eviction.
        </p>
        <p>
          What we found was surprising: <strong>
            which factors matter depends entirely on how you measure eviction.
          </strong> Warrant filings and actual evictions tell completely different
          stories.
        </p>
      </div>
    </section>

    <!-- 3. Process explainer -->
    <section class="story__section story__section--warm">
      <div class="container container--prose">
        <h2>The 4-step eviction process in Maryland</h2>
        <ol class="process-steps">
          <li>
            <strong>Filing</strong> — Landlord files a complaint with the District
            Court
          </li>
          <li>
            <strong>Hearing</strong> — Judge issues a judgment (usually possession)
          </li>
          <li>
            <strong>Warrant</strong> — If tenant doesn't comply, landlord requests
            a warrant of restitution
          </li>
          <li>
            <strong>Execution</strong> — Sheriff executes the warrant — the formal
            eviction
          </li>
        </ol>
        <p>
          Our data covers step 3. Fewer than 10% of warrants reach step 4. That
          gap is the central story.
        </p>
      </div>
    </section>

    <!-- 4. Where — maps -->
    <section class="story__section">
      <div class="container">
        <h2>Where are eviction warrants filed?</h2>
        <p class="section-intro">
          The geographic distribution of warrant filings doesn't map neatly onto
          the "Black Butterfly / White L" pattern that characterizes most
          inequities in Baltimore. That's the first hint that something
          different is going on.
        </p>
        <p class="section-note">
          See the <a href="/dashboard">interactive map</a> to explore by neighborhood.
        </p>
      </div>
    </section>

    <!-- 5. Which factors — BNIA correlations (setup) -->
    <section class="story__section story__section--warm">
      <div class="container">
        <h2>
          When we look at <em>actual</em> evictions, the pattern is familiar
        </h2>
        <p class="section-intro">
          BNIA's 2023 eviction data — which tracks formal evictions, not warrant
          filings — shows the expected correlations. Social determinants like
          race and income strongly predict eviction rates.
        </p>
        <div class="chart-pair">
          <div class="chart-col">
            <Scatterplot
              client:visible
              data={csaFeatures}
              xField="pct_black_non_hisp"
              yField="bnia_eviction_rate"
              xLabel="% Black, non-Hispanic"
              yLabel="BNIA eviction rate (per 1k)"
              rValue={0.57}
              pValue={0.0001}
              title="Race vs. BNIA eviction rate"
              color="var(--color-chart-scatter-bnia)"
            />
          </div>
          <div class="chart-col">
            <Scatterplot
              client:visible
              data={csaFeatures}
              xField="median_hh_income"
              yField="bnia_eviction_rate"
              xLabel="Median household income"
              yLabel="BNIA eviction rate (per 1k)"
              rValue={-0.62}
              pValue={0.0001}
              title="Income vs. BNIA eviction rate"
              color="var(--color-chart-scatter-bnia)"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Which factors — warrant correlations (twist) -->
    <section class="story__section">
      <div class="container">
        <h2>But warrant filings tell a completely different story</h2>
        <p class="section-intro">
          When we swap BNIA evictions for our warrant filing rate, the
          correlations collapse. Race and income are no longer significant
          predictors.
        </p>
        <div class="chart-pair">
          <div class="chart-col">
            <Scatterplot
              client:visible
              data={csaFeatures}
              xField="pct_black_non_hisp"
              yField="eviction_rate_per_1k_residents"
              xLabel="% Black, non-Hispanic"
              yLabel="Warrant rate (per 1k residents)"
              rValue={0.16}
              pValue={0.248}
              title="Race vs. warrant filing rate"
              color="var(--color-chart-warrant)"
            />
          </div>
          <div class="chart-col">
            <Scatterplot
              client:visible
              data={csaFeatures}
              xField="median_hh_income"
              yField="eviction_rate_per_1k_residents"
              xLabel="Median household income"
              yLabel="Warrant rate (per 1k residents)"
              rValue={-0.21}
              pValue={0.122}
              title="Income vs. warrant filing rate"
              color="var(--color-chart-warrant)"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- 7. Punchline — ownership concentration -->
    <section class="story__section story__section--warm">
      <div class="container">
        <h2>The strongest predictor: who controls the rental market</h2>
        <p class="section-intro">
          The only factor that significantly predicts warrant filing rates is
          ownership concentration — the share of rental units controlled by the
          top 10 landlords in each neighborhood.
        </p>
        <div class="chart-single">
          <Scatterplot
            client:visible
            data={csaFeatures}
            xField="ownership_concentration_pct"
            yField="eviction_rate_per_1k_residents"
            xLabel="Top-10 owner share of rental units (%)"
            yLabel="Warrant rate (per 1k residents)"
            rValue={0.45}
            pValue={0.001}
            title="Ownership concentration vs. warrant filing rate"
            color="var(--color-chart-warrant)"
          />
        </div>
        <div class="callout">
          <p>
            <strong
              >Even with a single month of data, our eviction measure and BNIA's
              tell the same story:</strong
            > income and race predict formally recorded evictions, but not warrant
            filings — where ownership concentration dominates instead.
          </p>
        </div>
      </div>
    </section>

    <!-- 8. Who — landlord concentration -->
    <section class="story__section">
      <div class="container">
        <h2>Who files the most warrants?</h2>
        <p class="section-intro">
          A handful of landlords are responsible for a <strong
            >disproportionate</strong
          >
          share of filings — and few of those warrants result in formal evictions.
        </p>
        <LandlordCharts
          client:visible
          concentrationData={concentrationData}
          top20Data={landlordTop20}
        />
      </div>
    </section>

    <!-- 9. Accountability asymmetry -->
    <section class="story__section story__section--dark">
      <div class="container container--prose">
        <h2>An asymmetry in consequences</h2>
        <div class="comparison">
          <div class="comparison__col">
            <h3>For tenants</h3>
            <ul>
              <li>Eviction records follow them for years</li>
              <li>Cases affect housing and credit access</li>
              <li>
                Difficult to expunge or seal cases decided in favor of the
                landlord
              </li>
            </ul>
          </div>
          <div class="comparison__col">
            <h3>For landlords</h3>
            <ul>
              <li>Filing patterns are largely inaccessible</li>
              <li>Frequent filers face no formal scrutiny</li>
              <li>No public record of cases decided against them</li>
            </ul>
          </div>
        </div>
        <div class="callout callout--dark">
          <p>
            When eviction rates and health outcomes share a similar set of
            factors, why does our system protect landlords from negligent
            renters — without protecting renters from predatory landlords?
          </p>
        </div>
      </div>
    </section>

    <!-- 10. CTA -->
    <section class="story__section story__section--dark">
      <div class="container container--prose" style="text-align:center">
        <h2>Explore the data yourself</h2>
        <p>
          The dataset is available for download and via a documented API. All
          tenant names are removed; addresses are truncated.
        </p>
        <div class="cta-row">
          <a href="/dashboard" class="btn btn--amber">Explore the map</a>
          <a href="/data" class="btn btn--outline">Download the data</a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .story__section {
    padding-block: var(--space-16);
  }

  .story__section--dark {
    background: var(--color-brown-700);
    color: var(--color-text-on-dark);
  }

  .story__section--dark h1,
  .story__section--dark h2 {
    color: var(--color-text-on-dark);
  }

  .story__section--dark p {
    color: rgba(255, 255, 255, 0.85);
  }

  .story__section--warm {
    background: var(--color-surface-alt);
  }

  .display-stat {
    font-size: var(--text-display);
    font-weight: var(--font-weight-extrabold);
    color: var(--color-amber-400);
    line-height: 1;
    margin-bottom: var(--space-4);
  }

  h1 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-6);
  }

  h2 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-6);
  }

  .lead {
    font-size: var(--text-xl);
    line-height: var(--leading-loose);
    color: rgba(255, 255, 255, 0.9);
  }

  p {
    margin-bottom: var(--space-4);
    line-height: var(--leading-loose);
  }

  .section-intro {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-8);
    max-width: var(--max-width-prose);
  }

  .section-note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: none;
  }

  .chart-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    margin-top: var(--space-8);
  }

  .chart-single {
    max-width: 560px;
    margin-block: var(--space-8);
  }

  .callout {
    background: var(--color-amber-100);
    border-left: 4px solid var(--color-amber-500);
    padding: var(--space-6);
    border-radius: 0 var(--border-radius-md) var(--border-radius-md) 0;
    margin-top: var(--space-8);
  }

  .callout p {
    max-width: none;
    margin: 0;
  }

  .callout--dark {
    background: rgba(255, 255, 255, 0.08);
    border-left-color: var(--color-amber-400);
  }

  .callout--dark p {
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--text-lg);
    line-height: var(--leading-loose);
  }

  .process-steps {
    padding-left: var(--space-6);
    margin-block: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .process-steps li {
    line-height: var(--leading-normal);
  }

  .comparison {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    margin-top: var(--space-6);
  }

  .comparison__col h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid rgba(255, 255, 255, 0.25);
    color: var(--color-text-on-dark);
  }

  .comparison__col ul {
    padding-left: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .comparison__col li {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: rgba(255, 255, 255, 0.85);
  }

  .cta-row {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: var(--space-3) var(--space-8);
    border-radius: var(--border-radius-sm);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-base);
    text-decoration: none;
  }

  .btn--amber {
    background: var(--color-amber-500);
    color: var(--color-brown-900);
  }

  .btn--outline {
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: var(--color-text-on-dark);
  }

  @media (max-width: 700px) {
    .chart-pair,
    .comparison {
      grid-template-columns: 1fr;
    }
  }
</style>
